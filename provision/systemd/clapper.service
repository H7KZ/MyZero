[Unit]
Description=MyZero clapper (clap -> Wake-on-LAN)
After=network-online.target
Wants=network-online.target

[Service]
# Config is read at startup from ENV_FILE — a named path rather than the
# default ./.env, since clapper and pcctl share %%HOME%%. Deploy it there
# before starting the service.
WorkingDirectory=%%HOME%%
Environment=ENV_FILE=%%HOME%%/clapper.env
ExecStart=%%HOME%%/clapper
Restart=on-failure
RestartSec=5
User=%%USER%%
# GPIO access for the sound sensor / LED (via /dev/gpiomem).
SupplementaryGroups=gpio

[Install]
WantedBy=multi-user.target
