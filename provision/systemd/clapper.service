[Unit]
Description=MyZero clapper (clap -> Wake-on-LAN)
After=network-online.target
Wants=network-online.target

[Service]
# Config is read at startup from ENV_FILE — a named path rather than the
# default ./.env, since clapper and pcctl share /home/pi. Deploy it there
# before starting the service.
WorkingDirectory=/home/pi
Environment=ENV_FILE=/home/pi/clapper.env
ExecStart=/home/pi/clapper
Restart=on-failure
RestartSec=5
User=pi
# GPIO access for the sound sensor / LED (via /dev/gpiomem).
SupplementaryGroups=gpio

[Install]
WantedBy=multi-user.target
