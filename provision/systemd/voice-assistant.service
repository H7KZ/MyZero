[Unit]
Description=MyZero voice-assistant (offline wake word -> actions)
After=network-online.target sound.target
Wants=network-online.target

[Service]
# Binary + models/ live in the user's home; model paths in .env are relative
# to WorkingDirectory.
WorkingDirectory=/home/pi
ExecStart=/home/pi/voice-assistant
Restart=on-failure
RestartSec=5
User=pi
# Needs audio device access (usually via the 'audio' group).
SupplementaryGroups=audio

[Install]
WantedBy=multi-user.target
