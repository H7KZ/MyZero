# Copy to .env (gitignored) and fill in real values.
# Values are baked into the binary at compile time via build.rs.

# ── Wake word ──────────────────────────────────────────────────────────────
# Must match what the Vosk model returns (lowercase, e.g. "jarvis").
WAKE_WORD=jarvis

# ── Speech-to-text (Vosk) ──────────────────────────────────────────────────
VOSK_MODEL_PATH=models/vosk-model-small-cs
AUDIO_SAMPLE_RATE=16000
LISTEN_TIMEOUT_SECS=6

# ── Text-to-speech (Piper) ─────────────────────────────────────────────────
PIPER_BIN=piper
PIPER_VOICE=models/cs_CZ-jirka-medium.onnx
# ALSA playback device; empty = default. Find yours with `aplay -l`.
APLAY_DEVICE=

# ── Feedback hardware (optional) ───────────────────────────────────────────
# BCM pin for the "listening" LED. 0 = disabled.
LED_GPIO_PIN=0
# Drive the SH1106 OLED for status text: true / false.
ENABLE_OLED=false

# ── Wake-on-LAN target ─────────────────────────────────────────────────────
WOL_TARGET_MAC=AA-BB-CC-DD-EE-FF
WOL_BROADCAST_ADDR=255.255.255.255
WOL_PORT=9
