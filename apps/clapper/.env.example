# Copy to .env (gitignored) and fill in real values.
# Values are baked into the binary at compile time via build.rs.

# ── Sound sensor (KY-038) clap trigger ─────────────────────────────────────
# BCM pin wired to the sensor's D0 output.
SOUND_GPIO_PIN=17
# Claps needed within the window to fire, and the window + per-clap debounce.
CLAP_COUNT=2
CLAP_WINDOW_MS=1500
CLAP_DEBOUNCE_MS=80

# ── Feedback hardware (optional) ───────────────────────────────────────────
# Status LED (BCM). 0 = disabled.
LED_GPIO_PIN=0
# Drive the SH1106 OLED for status text: true / false.
ENABLE_OLED=false

# ── Wake-on-LAN target ─────────────────────────────────────────────────────
WOL_TARGET_MAC=AA-BB-CC-DD-EE-FF
WOL_BROADCAST_ADDR=255.255.255.255
WOL_PORT=9
