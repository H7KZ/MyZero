# Copy to .env (gitignored) and fill in real values.
# Values are baked into the binary at compile time via build.rs, so rebuild
# after editing. Do not quote values and do not put trailing # comments on them.

# ── Target PC ──────────────────────────────────────────────────────────────
# MAC of the PC's *wired* NIC — the one the magic packet must reach.
# Windows: getmac /v      Linux: ip link show
PC_MAC=AA-BB-CC-DD-EE-FF
# Hostname or IP used for the liveness probe and (via the commands below) SSH.
# A DHCP reservation for the PC keeps this stable.
PC_HOST=192.168.1.50
# TCP port that proves the PC is actually usable, not merely powered:
#   22 = OpenSSH  ·  3389 = RDP  ·  47989 = Sunshine
PC_PROBE_PORT=22

# ── Wake-on-LAN ────────────────────────────────────────────────────────────
# Comma-separated broadcast addresses, tried in order. Put the subnet-directed
# broadcast first (your LAN prefix with the host bits set, e.g. 192.168.1.255):
# the limited broadcast 255.255.255.255 leaves via whichever interface the route
# table picks, which on a Pi also running the fallback hotspot may be uap0.
WOL_BROADCASTS=192.168.1.255,255.255.255.255
# Conventional WoL ports. Both cost nothing and remove a variable.
WOL_PORTS=9,7
# Bursts to send. Wi-Fi broadcasts are unacknowledged, so repeat a few times.
WOL_REPEAT=3
# Local IP to send from, pinning the outgoing interface. Empty = let the kernel
# choose. Set this to the Pi's LAN address if it also runs the hotspot.
WOL_BIND=

# ── Power-down commands ────────────────────────────────────────────────────
# Shell command lines run by `pcctl sleep` / `pcctl shutdown`. Empty disables
# that verb. Keep the connect timeouts — a hung command blocks a request.
# Sleep (S3) is the WoL-friendly resting state; see docs/remote-pc-control.md.
SLEEP_COMMAND=ssh -i /home/pi/.ssh/id_pcctl -o BatchMode=yes -o ConnectTimeout=5 pcpower@192.168.1.50 sleep
SHUTDOWN_COMMAND=ssh -i /home/pi/.ssh/id_pcctl -o BatchMode=yes -o ConnectTimeout=5 pcpower@192.168.1.50 shutdown
# Seconds before a power-down command is killed.
COMMAND_TIMEOUT_SECS=30

# ── HTTP control API (`pcctl serve`) ───────────────────────────────────────
# Bind address. 127.0.0.1 = local only. To reach it from your phone/laptop,
# bind the Pi's Tailscale address (100.x.y.z:8080) — never a public interface.
LISTEN_ADDR=127.0.0.1:8080
# Bearer token / ?token= value. Required unless LISTEN_ADDR is loopback.
# Generate one: openssl rand -hex 32
API_TOKEN=
# How long `pcctl wake --wait` and POST /wake?wait=1 poll for the PC to answer.
WAKE_TIMEOUT_SECS=120
